rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == "PASTE_OWNER_AUTH_UID";
    }
    match /products/{productId} {
      allow read: if resource.data.available == true || isOwner();
      allow create, update, delete: if isOwner();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}